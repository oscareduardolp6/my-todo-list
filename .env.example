# Misma config de Firebase que Hilo (mismo proyecto, misma Auth con Google).
# No son valores secretos — lo que protege los datos son las reglas de
# Firestore (firestore.rules). Copia este archivo a .env.local (ya ignorado
# por git) y pega los valores de tu proyecto: Consola de Firebase →
# Configuración del proyecto → Tus apps → SDK.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
